{
  "name": "humansurvival",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "check-overrides": "node check-override-expirations.js",
    "render-table": "npx five-server ./build/ & npx nodemon --ext js,css,md --watch . render-table.js",
    "render-timeline": "npx five-server ./build/ --open=timeline.html & npx nodemon --ext js,css,md --watch . render-timeline.js",
    "publish": "npx gh-pages -d build",
    "build": "node index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "capture-website": "^5.1.0",
    "clean-html": "^2.0.1",
    "csv-parse": "^7.0.2",
    "es-main": "^1.4.0",
    "jsdom": "^20.0.0",
    "lodash": "^4.17.21",
    "marked": "^18.0.7",
    "nodemon": "^3.1.14",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "devDependencies": {
    "eslint": "^8.22.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.2.4",
    "eslint-plugin-promise": "^6.0.0",
    "five-server": "^0.5.0",
    "gh-pages": "^6.0.0",
    "simple-git-hooks": "^2.14.0",
    "standard": "^17.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check-overrides && npx standard"
  },
  "overrides": {
    "puppeteer": "25.16.0",
    "chokidar": "^4.0.3",
    "html-validate": {
      "glob": "^14.0.4"
    },
    "nodemon": {
      "minimatch": "^11.0.5"
    }
  },
  "overridesMeta": {
    "puppeteer": {
      "expires": "2026-12-07",
      "reason": "Remove when capture-website supports puppeteer 25+"
    },
    "chokidar": {
      "expires": "2026-12-07",
      "reason": "Remove when five-server/nodemon depend on chokidar 4+"
    },
    "html-validate.glob": {
      "expires": "2026-12-07",
      "reason": "Remove when five-server uses html-validate 11.1+ (no glob) or glob 14.0.2+"
    },
    "nodemon.minimatch": {
      "expires": "2026-12-07",
      "reason": "Remove when nodemon depends on minimatch 11.0.1+"
    }
  }
}
